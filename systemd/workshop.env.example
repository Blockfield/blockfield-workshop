# /etc/blockfield/workshop.env (root:root 0600). Имена сервисов — как в `docker service ls` (Dokploy добавляет суффикс).
BF_GAME_SERVICE=blockfield-server-lfcxy0
BF_WORKSHOP_SERVICE=blockfield-workshop-5jx22e
BF_GAME_DATA=/srv/minecraft/lobby
BF_WORKSHOP_DATA=/srv/minecraft/workshop/data
BF_LOCK_DIR=/srv/minecraft/backend-lock
BF_STATE_DIR=/srv/minecraft/workshop/controller
BF_GATE_FILE=/srv/minecraft/workshop/gate/gate.json
BF_PUBLIC_FILE=/srv/minecraft/workshop/public/public.json
BF_ADMIN_DIR=/srv/minecraft/workshop/admin
BF_INBOX_DIR=/srv/minecraft/workshop/inbox
# Значение по умолчанию; сообщение из админки сайта (controller/message.json) имеет приоритет.
#BF_MAINTENANCE_MESSAGE=На сервере проводятся технические работы. Обычный вход временно недоступен.
# Дедлайны DRAINING/STARTING (сек); при превышении controller откатывается на предыдущий стабильный профиль сам.
#BF_DRAIN_TIMEOUT_S=600
#BF_DRAIN_TIMEOUT_RANKED_S=3600
#BF_DRAIN_HEALTH_GRACE_S=60
#BF_START_TIMEOUT_S=300
