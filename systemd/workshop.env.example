# /etc/blockfield/workshop.env (root:root 0600). Имена сервисов — как в `docker service ls` (Dokploy добавляет суффикс).
BF_GAME_SERVICE=blockfield-server-lfcxy0
BF_WORKSHOP_SERVICE=blockfield-workshop-5jx22e
# Limbo activation is disabled until this names the exact separate Dokploy proxy service.
#BF_PROXY_SERVICE=blockfield-proxy-<dokploy-suffix>
BF_GAME_DATA=/srv/minecraft/lobby
BF_WORKSHOP_DATA=/srv/minecraft/workshop/data
BF_LOCK_DIR=/srv/minecraft/backend-lock
BF_STATE_DIR=/srv/minecraft/workshop/controller
BF_GATE_FILE=/srv/minecraft/workshop/gate/gate.json
BF_PUBLIC_FILE=/srv/minecraft/workshop/public/public.json
BF_ADMIN_DIR=/srv/minecraft/workshop/admin
BF_INBOX_DIR=/srv/minecraft/workshop/inbox
# HDD mount must be required by the host unit. Cold blobs, manifests and derived ZIP cache live here.
BF_MAP_ARCHIVE_DIR=/mnt/media-hdd/blockfield/maps
BF_CANDIDATES_DIR=/mnt/media-hdd/blockfield/maps/candidates
BF_LEGACY_CANDIDATES_DIR=/srv/minecraft/workshop/candidates
BF_MAP_PACKAGES_DIR=/mnt/media-hdd/blockfield/maps/packages
BF_MAP_BACKUPS_DIR=/mnt/media-hdd/blockfield/maps/backups
BF_LIMBO_DERIVED_DIR=/mnt/media-hdd/blockfield/maps/limbo
# Runtime bundles, per-map head.json and isolated editable copies: SSD.
BF_MAP_ACTIVE_DIR=/srv/minecraft/maps-active
# Optional host read-only bind mirror directories for Dokploy deployments.
# Production Dokploy Swarm Mounts cannot store the ReadOnly field. Operator creates
# non-recursive host readonly bind mirrors (bind,ro) so active map and admin mounts
# remain read-only in the kernel across redeploys.
#BF_MAP_ACTIVE_READONLY_DIR=/srv/minecraft/views/maps-active
#BF_ADMIN_READONLY_DIR=/srv/minecraft/views/workshop-admin
# Значение по умолчанию; сообщение из админки сайта (controller/message.json) имеет приоритет.
#BF_MAINTENANCE_MESSAGE=На сервере проводятся технические работы. Обычный вход временно недоступен.
# Дедлайны DRAINING/STARTING (сек); при превышении controller откатывается на предыдущий стабильный профиль сам.
#BF_DRAIN_TIMEOUT_S=600
#BF_DRAIN_TIMEOUT_RANKED_S=3600
#BF_DRAIN_HEALTH_GRACE_S=60
#BF_START_TIMEOUT_S=600
# Cold Workshop: seconds of continuous idleness before the stable editor sleeps (0 disables).
#BF_WORKSHOP_IDLE_SLEEP_S=900
