# Host-controller paths only. The OpenRouter key belongs to the Workshop service, never this file.
# BF_AI_SETTINGS_DIR defaults to BF_GAME_DATA/blockfield-admin; match the site's physical settings directory.
BF_AI_SETTINGS_DIR=/srv/minecraft/lobby/blockfield-admin
# Existing operator-created read-only mirror; same inode and kernel ST_RDONLY are required.
BF_AI_SETTINGS_READONLY_DIR=/srv/minecraft/views/blockfield-admin
