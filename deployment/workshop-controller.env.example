# Container environment for the Workshop controller (documentation only).
# Copy nothing with values into Dokploy: secrets travel exclusively through
# the secret files referenced below (0600, root-owned on the host), never
# through this file, the image, logs or controller state.
BF_WORKSHOP_BACKEND=dokploy
BF_STATE_DIR=/state
BF_GATE_FILE=/state/gate/gate.json
BF_PUBLIC_FILE=/state/public/public.json
BF_ADMIN_DIR=/state/admin
BF_WORKSHOP_DATA=/data
BF_LOCK_DIR=/locks
BF_MAP_ARCHIVE_DIR=/data/history
BF_MAP_ACTIVE_DIR=/data/active
BF_TEMPLATES_DIR=/templates
BF_PUBLISHED_MAPS_DIR=/published
BF_RELEASES_FILE=/state/releases.json
BF_STEP_INTERVAL_S=15
BF_STEP_FOLLOW_S=12
BF_STEP_POLL_S=2
BF_START_TIMEOUT_S=600
BF_WORKSHOP_IDLE_SLEEP_S=900
BF_WORKSHOP_READY_TTL_S=60
BF_HEALTH_PORT=8080
# Control Plane (inject tokens via runtime env, never commit values):
# BLOCKFIELD_CP_URL=https://control-plane.example.invalid
# BLOCKFIELD_CP_AGENT_ID=workshop-1
# BLOCKFIELD_CP_AGENT_TOKEN=<agent-token>
# BLOCKFIELD_CP_AGENT_GENERATION=<uuid>
# BLOCKFIELD_CP_GATE_TOKEN=<reporter-token: workshop.gate,workshop.report,workshop.read,workshop.game>
# BLOCKFIELD_CP_WORKSHOP_GAME_CONSUMER_ID=ws-game
# BLOCKFIELD_CP_WORKSHOP_GAME_GENERATION=<uuid>
# BLOCKFIELD_CP_ENVIRONMENT=prod
# BLOCKFIELD_CP_BACKEND=game
# Optional restart secret: the Workshop app's Dokploy deploy webhook URL (same
# value the server CI holds as DOKPLOY_WORKSHOP_WEBHOOK). When set, the
# controller POSTs it after persisting a start so a stopped editor restarts
# without a manual deploy; unset keeps the manual-deploy path with a warning.
# Either an env value or a mounted secret file; never log or print it.
# WORKSHOP_DEPLOY_WEBHOOK_URL=https://dokploy.example.invalid/api/app/deploy/<id>
# WORKSHOP_DEPLOY_WEBHOOK_URL_FILE=/run/secrets/workshop-deploy-webhook-url
